# Copy this file to .env.local and fill in the values.
# Never commit .env.local or real secrets.

# Server-side API key for the LLM provider used to analyze resumes.
# Provider: Google Gemini. Create a free key at https://aistudio.google.com/apikey
# Do NOT prefix with NEXT_PUBLIC_ — this must stay server-side only.
LLM_API_KEY=

# Optional: override the Gemini model used for analysis (default: gemini-2.5-flash).
# LLM_MODEL=gemini-2.0-flash
