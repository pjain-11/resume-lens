# Copy this file to .env.local and fill in the values.
# Never commit .env.local or real secrets.

# Server-side API key for the LLM provider used to analyze resumes.
# Provider: Anthropic (Claude). Create a key at https://console.anthropic.com/
# Do NOT prefix with NEXT_PUBLIC_ — this must stay server-side only.
LLM_API_KEY=

# Optional: override the Claude model used for analysis (default: claude-opus-5).
# LLM_MODEL=claude-opus-5
